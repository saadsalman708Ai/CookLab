{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cooklab.local/schemas/specialized-project-v1.schema.json",
  "title": "CookLab Specialized Project Plan v1",
  "description": "Compact creative edit plan. Asset existence, overlay parameter compatibility, and timeline semantics require application-level validation beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "transcript",
    "segments",
    "themes",
    "music",
    "overlays"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "transcript": {
      "type": "array",
      "description": "Word-level timestamps as [startSeconds, endSeconds, exactWordText]. Preserve the supplied words, order, punctuation, and timing.",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "number",
            "exclusiveMinimum": 0
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "segments": {
      "type": "array",
      "description": "Semantic visual intervals; not one cut per word. Each word should map to exactly one segment using its start time and half-open intervals [start,end).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "purpose",
          "footage"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "footage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query",
              "keywords"
            ],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "alternates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "visualIntent": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "description": "Explicit exact filenames from the configured theme library; no IDs or machine-specific paths.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "file"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "music": {
      "type": "array",
      "description": "Explicit exact filenames from the configured music library; no IDs or machine-specific paths.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "file"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "description": "Overlay folder names plus creative values supported by that folder's manifest. The app validates every parameter against the manifest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "folder",
          "parameters"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^/\\\\]+$"
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Optional and valid only when the selected manifest supports custom duration and the value is within its declared range."
          },
          "parameters": {
            "type": "object",
            "description": "Manifest-defined parameter IDs and values only. Values are checked against the selected overlay manifest at runtime.",
            "additionalProperties": true
          },
          "purpose": {
            "type": "string",
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "assetRecommendations": {
      "type": "array",
      "description": "Suggestions for assets not present or not suitable in the inventory; never invent a filename/folder as if it already exists.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "reason",
          "desiredCharacteristics",
          "searchTerms"
        ],
        "properties": {
          "category": {
            "enum": [
              "footage",
              "theme",
              "music",
              "overlay"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "desiredCharacteristics": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "searchTerms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    },
    "directorNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  }
}
